# Template for .env.test, which the Supabase access tests read.
# Copy this file to .env.test (git ignores it) and fill in the values there.
# Never paste these values into a chat, and never put the secret
# (service-role) key in this file or anywhere the app or tests can read.
#
# No VITE_ prefix on purpose: Vite only exposes VITE_ variables to browser
# code, so these stay in the test process.

# Project URL, like https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe for browsers by design;
# row-level security is what protects the data.
SUPABASE_PUBLISHABLE_KEY=

# The two test users you created in Authentication > Users.
# Use test-only passwords, not a password you use anywhere else.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
